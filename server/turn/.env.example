# PortalBreakout TURN relay configuration.
# Copy to .env (start.sh does this for you) — .env is gitignored, never commit it.

# Shared secret between coturn and the credentials endpoint.
# LEAVE EMPTY: start.sh generates a strong one automatically on first run.
TURN_SECRET=

# Public address players reach the relay on: your server's public IP or a DNS
# name pointing at it. LEAVE EMPTY to let start.sh auto-detect the public IP.
TURN_HOST=

# TURN listening port (UDP+TCP) and UDP relay port range.
# Open these in your firewall: TURN_PORT udp+tcp, TURN_MIN_PORT-TURN_MAX_PORT udp.
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Authentication realm (any label; shown in TURN handshakes).
TURN_REALM=portalbreakout

# Credentials endpoint: bind address and port. Default binds loopback only —
# put your TLS reverse proxy in front (the game page is https, so the endpoint
# must be reachable over https, e.g. https://turn.example.com/ice).
CREDS_BIND=127.0.0.1
CREDS_PORT=8788

# Lifetime of minted TURN credentials, seconds (>= 300).
CREDS_TTL_S=7200

# Comma-separated list of allowed browser origins for the endpoint,
# or * to allow any (credentials are short-lived and rate-limited anyway).
CORS_ORIGIN=https://lp177.github.io

# Only needed behind 1:1 NAT (public IP not bound on the interface) — also
# uncomment the --external-ip line in docker-compose.yml.
#TURN_EXTERNAL_IP=
#TURN_INTERNAL_IP=
