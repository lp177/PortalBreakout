# PortalBreakout TURN credentials endpoint — rootless Quadlet unit.
# Expects %h/turn/.env (TURN_SECRET, TURN_HOST, …) and %h/turn/creds-server.mjs.
[Unit]
Description=PortalBreakout TURN credentials endpoint
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/library/node:24-alpine
ContainerName=turn-credentials
EnvironmentFile=%h/turn/.env
Volume=%h/turn/creds-server.mjs:/app/creds-server.mjs:ro
Exec=node /app/creds-server.mjs
# Loopback only — the host reverse proxy terminates TLS in front of /ice.
PublishPort=127.0.0.1:8788:8788

[Service]
Restart=always

[Install]
WantedBy=default.target
